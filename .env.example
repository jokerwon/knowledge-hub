# 数据层：PG 存文档元数据与正文（使用已就绪的远程服务，不在本地跑 Docker）
DATABASE_URL=postgresql://user:123456@localhost:5432/knowledge_hub

# e2e 测试库：vitest 每次运行会 DROP/CREATE 该库并重跑全部 migration（库名必须以 _test 结尾，勿指向开发/生产库）
TEST_DATABASE_URL=postgresql://user:123456@localhost:5432/knowledge_hub_test

# 摄取参数
UPLOAD_MAX_BYTES=2097152

# 会话签名密钥（openssl rand -base64 32 生成，部署时自行生成）
JWT_SECRET=change-me
