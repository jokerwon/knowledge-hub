# 数据层（P3 启用，PG 与 Mongo 二选一，见 ADR-0005）
DATABASE_URL=postgresql://user:123456@localhost:5432/knowledge_hub
MONGO_URL=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# LLM 内部网关（P2/P5 启用，见 ADR-0007）
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBED_MODEL=

# 摄取与检索参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
UPLOAD_MAX_BYTES=2097152
INGEST_TIMEOUT_MS=60000
EMBEDDING_DIM=768
